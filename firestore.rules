rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Proprietaire : le compte identifie par son e-mail (le meme que dans src/config.ts)
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'malekjaber955@gmail.com';
    }

    // Admin : le proprietaire, ou un compte cree par lui avec le role « admin » (actif)
    function isAdmin() {
      return isOwner()
        || (request.auth != null
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true);
    }

    // Commercial : compte cree par l'admin, actif, avec un profil users/{uid}
    function isCommercial() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'commercial'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    // Profils : lisibles par les admins et par la personne concernee.
    // Le proprietaire gere tout ; un autre admin ne peut creer/modifier/supprimer que des commerciaux.
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if isOwner() || (isAdmin() && request.resource.data.role == 'commercial');
      allow update: if isOwner()
        || (isAdmin() && resource.data.role == 'commercial' && request.resource.data.role == 'commercial');
      allow delete: if isOwner() || (isAdmin() && resource.data.role == 'commercial');
    }

    // Reglages du contenu (articles masques, prix ajustes, remise maximale)
    match /settings/{docId} {
      allow read: if isAdmin() || isCommercial();
      allow write: if isAdmin();
    }

    // Articles ajoutes par l'admin (propres a cette application) : lecture admin + commerciaux, ecriture admin
    match /products/{productId} {
      allow read: if isAdmin() || isCommercial();
      allow write: if isAdmin();
    }

    // Devis : le commercial cree les siens (toujours « en attente ») et les lit ; l'admin les modifie et les valide ; le commercial modifie les siens tant qu'ils sont en attente
    match /quotes/{quoteId} {
      allow create: if (isCommercial() || isAdmin())
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('status', 'attente') == 'attente';
      allow read: if isAdmin()
        || (isCommercial() && resource.data.ownerUid == request.auth.uid);
      // Le commercial peut modifier son devis tant qu'il n'est pas valide (son contenu seulement, jamais l'etat)
      allow update: if isAdmin()
        || (isCommercial()
            && resource.data.ownerUid == request.auth.uid
            && resource.data.get('status', 'attente') != 'valide'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['client', 'clientId', 'phone', 'note', 'discountPct', 'lines', 'subtotal', 'discount', 'total']));
      allow delete: if isAdmin();
    }

    // Clients : chaque commercial gere les siens ; l'admin gere tout
    match /clients/{clientId} {
      allow create: if (isCommercial() || isAdmin())
        && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);
      allow read: if isAdmin()
        || (isCommercial() && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin()
        || (isCommercial()
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin();
    }

    // Commandes : le commercial les cree (depuis un devis) et les lit ; l'admin les gere
    match /orders/{orderId} {
      allow create: if (isCommercial() || isAdmin())
        && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);
      allow read: if isAdmin()
        || (isCommercial() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Factures et compteurs : admin uniquement
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }
  }
}
