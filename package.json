{
  "name": "commercial-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:desktop": "vite build --mode desktop --outDir dist-desktop",
    "desktop": "npm run build:desktop && electron .",
    "package:desktop": "npm run build:desktop && electron-packager . Admin-CinqFreres --platform=win32 --arch=x64 --out=release --overwrite --prune=false --ignore=\"^/(src|scripts|public|dist|release|.git|.github|.env.*|node_modules|tsconfig.*|vite.config.ts|firestore.rules|README.md|package-lock.json|.oxlintrc.json|index.html)(/|$)\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.19.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "main": "electron/main.cjs"
}